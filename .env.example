# Copy to .env and fill in. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# INVOICE_MODEL=gemini-3.5-flash-lite
# INVOICE_FALLBACK_MODEL=gemini-3.1-flash-lite   # "none" disables the fallback
# INVOICE_THINKING_LEVEL=low                     # minimal | low | medium | high
# INVOICE_INPUT_MODE=hybrid                      # hybrid | images | pdf
# INVOICE_MAX_RETRIES=1                          # corrective re-reads after a failed check
# INVOICE_SECOND_READ=on                         # verify doubtful reads with a second model
# INVOICE_SECOND_READ_MODEL=gemini-3.1-flash-lite
# INVOICE_REFERENCE_DATE=2026-11-21              # pin 'today' for the stale-invoice check
# INVOICE_REQUEST_TIMEOUT_S=60
